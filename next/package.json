{
    "name": "first-next",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.13 <23"
    },
    "scripts": {
        "dev": "next dev --webpack",
        "build": "next build --webpack",
        "build:static": "NEXT_OUTPUT=export next build --webpack",
        "start": "next start",
        "start:standalone": "node scripts/start-standalone.mjs",
        "assets:rights:inventory": "node scripts/verify-image-rights.mjs",
        "assets:rights:policy-test": "node --test scripts/image-rights-policy.test.mjs",
        "assets:rights:release": "node scripts/verify-image-rights.mjs --require-cleared",
        "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{js,jsx,ts,tsx,scss}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts,json}\"",
        "lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings=0",
        "planner:lab:check": "PLANNER_LAB_WRITE_REPORT=1 vitest run src/shared/lib/furniture-planner/room-lab.test.ts --reporter=verbose",
        "planner:lab:render": "PLANNER_LAB_WRITE_REPORT=1 PLANNER_LAB_RENDER=1 vitest run src/shared/lib/furniture-planner/room-lab.test.ts --reporter=verbose",
        "typecheck": "next typegen && tsc --noEmit --incremental false",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed"
    },
    "dependencies": {
        "clsx": "^2.1.0",
        "next": "16.4.2",
        "normalize.css": "^8.0.1",
        "react": "^18",
        "react-dom": "^18",
        "sharp": "0.35.5"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.12.1",
        "@playwright/test": "1.61.1",
        "@types/node": "22.20.1",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "eslint": "9.39.2",
        "eslint-config-next": "16.4.2",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "prettier": "^3.2.5",
        "sass": "^1.105.2",
        "typescript": "^5",
        "vitest": "^3.2.7"
    },
    "overrides": {
        "nanoid": "3.3.20",
        "next": {
            "sharp": "0.35.5"
        },
        "postcss": "8.5.30"
    }
}
