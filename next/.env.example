# Same-origin API path. `next dev` proxies it to API_PROXY_TARGET.
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=http://localhost:3001
# Set both public flags to true only together with the matching server flags.
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_AUTH_REGISTRATION_ENABLED=false
NEXT_PUBLIC_BETA_BADGE_ENABLED=true
