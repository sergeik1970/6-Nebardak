SITE_ADDRESS=:80
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_AUTH_REGISTRATION_ENABLED=false
NEXT_PUBLIC_BETA_BADGE_ENABLED=true
# Yandex Metrika counter (stylefinder.online). Empty builds the site without analytics.
NEXT_PUBLIC_YM_COUNTER_ID=113737739

POSTGRES_DB=stylefinder
POSTGRES_ADMIN_USER=stylefinder_admin
POSTGRES_ADMIN_PASSWORD=
APP_DB_USER=stylefinder_app
APP_DB_PASSWORD=
MIGRATOR_DB_USER=stylefinder_migrator
MIGRATOR_DB_PASSWORD=

# Required once AUTH_ENABLED=true: the exact https origin of the site.
PUBLIC_ORIGIN=
# Required once AUTH_ENABLED=true: a relay authorised by SPF/DKIM for the sender domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Nest has no internet access. To reach the provider, point SMTP_HOST/PORT at the
# relay and keep the provider's name for TLS, e.g.:
#   SMTP_RELAY_UPSTREAM=mail.hosting.reg.ru:465
#   SMTP_HOST=smtp-relay  SMTP_PORT=2465  SMTP_SECURE=true
#   SMTP_TLS_SERVERNAME=mail.hosting.reg.ru
SMTP_RELAY_UPSTREAM=
SMTP_TLS_SERVERNAME=
AUTH_ENABLED=false
AUTH_REGISTRATION_ENABLED=false
TRUST_PROXY_HOPS=1
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_REQUESTS=120
DB_STATEMENT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=6000
DB_CONNECTION_TIMEOUT_MS=5000
DB_READINESS_TIMEOUT_MS=3000
