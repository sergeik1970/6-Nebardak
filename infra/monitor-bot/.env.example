# Copy to .env next to compose.yml (chmod 600). Never commit the real file.

# From @BotFather, and the owner's chat id (only this chat gets alerts and answers).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISPLAY_TIMEZONE=Europe/Moscow
CHECK_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
# Consecutive failures before an alert; reminders while a check stays down.
FAILURE_THRESHOLD=2
REMINDER_HOURS=6
TLS_WARN_DAYS=14

# Production internals over SSH. Leave PROD_SSH_TARGET empty to watch HTTP only.
PROD_SSH_TARGET=stylefinder-monitor@62.113.60.95
PROD_INTERVAL_SECONDS=300
PROD_SERVICES=caddy,next,nest,db
DISK_LIMIT_PERCENT=80
MEMORY_AVAILABLE_MIN_PERCENT=10
BACKUP_MAX_AGE_HOURS=26

# Optional Healthchecks.io ping URL: alerts if this bot or its server goes silent.
HC_PING_URL=
