# Copy to .env next to compose.yml (chmod 600). Never commit the real file.

# From @BotFather, and the owner's chat id (only this chat gets alerts and answers).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISPLAY_TIMEZONE=Europe/Moscow
# Checks run on the wall-clock grid of their interval (60 → every hh:mm:00).
CHECK_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
# Consecutive failures before an alert; reminders while a check stays down.
FAILURE_THRESHOLD=2
# A target that does not answer is checked again this often until the next minute.
HTTP_RETRY_SECONDS=10
REMINDER_HOURS=6
TLS_WARN_DAYS=14
TLS_INTERVAL_SECONDS=300
# A correct answer slower than this counts as a failure (per target: "slowMs" in targets.json).
SLOW_RESPONSE_MS=3000
# Daily summary at HH:MM in DISPLAY_TIMEZONE, or "off".
DAILY_REPORT_TIME=09:00

# Production internals over SSH. Leave PROD_SSH_TARGET empty to watch HTTP only.
PROD_SSH_TARGET=stylefinder-monitor@62.113.60.95
PROD_INTERVAL_SECONDS=300
PROD_SERVICES=caddy,next,nest,db,smtp-relay
DISK_LIMIT_PERCENT=80
MEMORY_AVAILABLE_MIN_PERCENT=10
BACKUP_MAX_AGE_HOURS=26

# Optional Yandex Metrika funnel in the daily report and /funnel. Token from
# oauth.yandex.ru with only "metrika:read"; it lives a year, the bot says when it expires.
METRIKA_TOKEN=
METRIKA_COUNTER_ID=113737739

# Optional Healthchecks.io ping URL: alerts if this bot or its server goes silent.
HC_PING_URL=
