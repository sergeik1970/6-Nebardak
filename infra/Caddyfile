{
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Sessions and CSRF checks are bound to the apex origin (PUBLIC_ORIGIN), so
	# a page served from www could not sign in. Send www to the apex instead.
	@www header_regexp www Host ^www\.([^:]+)
	redir @www https://{re.www.1}{uri} permanent

	@api path /api/*
	handle @api {
		reverse_proxy nest:3001
	}

	@immutable path /_next/static/*
	header @immutable >Cache-Control "public, max-age=31536000, immutable"

	@versionedPlannerAssets path_regexp versionedPlannerAssets ^/images/planner/.+\.[0-9]{8}-v[0-9]+\.webp$
	header @versionedPlannerAssets >Cache-Control "public, max-age=31536000, immutable"

	@versionedTestAssets path /images/Home/test-images.20260716-v1/*
	header @versionedTestAssets >Cache-Control "public, max-age=31536000, immutable"

	@fingerprintedHomeAssets path_regexp fingerprintedHomeAssets ^/images/Home/[^/]+\.[0-9a-f]{12}\.(jpg|webp|png)$
	header @fingerprintedHomeAssets >Cache-Control "public, max-age=31536000, immutable"

	header {
		-Server
		-X-Powered-By
		# Yandex Metrika: tag.js and its beacons (mc.*), and framing by metrika.yandex.* so its
		# click and link maps can overlay the site. Session replay (webvisor) is not enabled.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors https://metrika.yandex.ru https://metrika.yandex.com; form-action 'self'; frame-src https://mc.yandex.ru https://mc.yandex.com; img-src 'self' data: blob: https://mc.yandex.ru https://mc.yandex.com; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://yastatic.net; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com; worker-src 'self' blob:"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		X-Permitted-Cross-Domain-Policies "none"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
	}

	handle {
		reverse_proxy next:3000
	}

	log {
		output stdout
		format json
	}
}
