# Install as /etc/stylefinder/backup.env, owner root, mode 600.

# Checkout that contains docker-compose.yml and .env.server.
APP_DIR=/srv/stylefinder

# Public half of an age key pair generated off the server (age-keygen).
# The private key stays with the owner and on the restore-drill machine.
AGE_RECIPIENT=age1...

# S3-compatible storage in Russia. Yandex Object Storage:
#   S3_ENDPOINT=https://storage.yandexcloud.net  S3_REGION=ru-central1
# Selectel:
#   S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru  S3_REGION=ru-1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=stylefinder-backups
# Upload-only key for this bucket: no read, list or delete rights.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Healthchecks.io ping URLs (https://hc-ping.com/<uuid>).
HC_BACKUP_PING_URL=
HC_RESOURCES_PING_URL=
