# Copy to .env next to compose.yml (chmod 600). Never commit the real file.

# Callers send this as "Authorization: Bearer <token>". At least 32 characters:
#   openssl rand -hex 32
RELAY_TOKEN=

# The provider key and model. AI_PROVIDER is gemini or openai (any
# OpenAI-compatible API); without it a model starting with "gemini" means Gemini.
AI_API_KEY=
AI_MODEL=gemini-2.5-pro
AI_PROVIDER=
# Other models a request may choose (comma-separated), e.g. for comparing them.
AI_MODELS=
# Only for OpenAI-compatible services other than OpenAI, e.g. https://example.com/v1
AI_API_URL=

# Dollars per million tokens, only for providers that do not report the price
# themselves (OpenRouter does). Without them such requests count as unpriced.
AI_PRICE_INPUT_PER_M=
AI_PRICE_OUTPUT_PER_M=

# Requests per UTC day; a leaked token cannot spend more than this.
RELAY_DAILY_LIMIT=300
# Whole-apartment plans take a model up to ~2 minutes of thinking.
RELAY_TIMEOUT_SECONDS=300
