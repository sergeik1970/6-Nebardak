DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=stylefinder
# Production rejects this placeholder; generate a secret with: openssl rand -hex 32
JWT_SECRET=change_this_secret_in_production
JWT_ISSUER=stylefinder-api
JWT_AUDIENCE=stylefinder-web
NODE_ENV=dev
PORT=3001
TRUST_PROXY_HOPS=0
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_REQUESTS=120
# Authentication stays disabled until an approved non-template JWT secret
# (at least 32 characters) is supplied through the local secret workflow.
AUTH_ENABLED=false
AUTH_REGISTRATION_ENABLED=false
# Before enabling auth, force a password reset for every legacy bcrypt hash
# below cost 12. Such hashes are deliberately rejected and never upgraded on login.
DB_STATEMENT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=6000
DB_CONNECTION_TIMEOUT_MS=5000
DB_READINESS_TIMEOUT_MS=3000
