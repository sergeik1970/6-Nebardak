{
    "name": "nest-next",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "engines": {
        "node": ">=22.13 <23"
    },
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"typeOrm.config.ts\"",
        "start": "nest start",
        "start:dev": "NODE_ENV='dev' nest start --watch",
        "start:debug": "NODE_ENV='dev' nest start --debug --watch",
        "start:prod": "node dist/src/main",
        "deploy:migrate": "npm run typeorm:run-migrations:prod",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "typecheck": "tsc --noEmit --incremental false",
        "test": "jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
        "test:db": "sh ./scripts/test-db.sh",
        "test:watch": "jest --watch",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "typeorm": "ts-node ./node_modules/typeorm/cli",
        "typeorm:run-migrations": "npm run typeorm migration:run -- -d ./typeOrm.config.ts",
        "typeorm:run-migrations:prod": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/typeOrm.config.js",
        "typeorm:generate-migration": "npm run typeorm -- -d ./typeOrm.config.ts migration:generate ./migrations/$npm_config_name",
        "typeorm:create-migration": "npm run typeorm -- migration:create ./migrations/$npm_config_name",
        "typeorm:revert-migration": "npm run typeorm -- -d ./typeOrm.config.ts migration:revert",
        "typeorm:revert-migration:prod": "node ./node_modules/typeorm/cli.js migration:revert -d ./dist/typeOrm.config.js",
        "admin:grant": "ts-node -r tsconfig-paths/register scripts/grant-admin.ts"
    },
    "dependencies": {
        "@nestjs/common": "11.2.7",
        "@nestjs/core": "11.2.7",
        "@nestjs/platform-express": "11.2.7",
        "@nestjs/throttler": "6.4.0",
        "@nestjs/typeorm": "11.0.3",
        "bcryptjs": "^3.0.2",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.2",
        "express": "5.2.1",
        "nodemailer": "10.0.15",
        "pg": "^8.11.3",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.1",
        "typeorm": "0.3.31"
    },
    "devDependencies": {
        "@nestjs/cli": "11.0.24",
        "@nestjs/schematics": "11.1.0",
        "@nestjs/testing": "11.2.7",
        "@types/express": "5.0.6",
        "@types/jest": "^29.5.2",
        "@types/node": "22.20.1",
        "@types/supertest": "^6.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.5.0",
        "prettier": "^3.0.0",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.0",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "overrides": {
        "@typescript-eslint/typescript-estree": {
            "minimatch": "9.0.9"
        },
        "brace-expansion": "2.1.7"
    }
}
